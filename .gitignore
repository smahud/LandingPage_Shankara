# ─────────────────────────────────────────────────────────────
# Shankara Well — .gitignore
# ─────────────────────────────────────────────────────────────

# dependencies
node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# env files — JANGAN pernah commit aslinya (hanya .env.example)
.env*
!.env.example

# all logs
*.log
server.log

# vercel
.vercel

# ── SEKURITI: kunci deploy & rahasia — JANGAN PERNAH di-push ──
/.ssh/

# ── Data runtime (di-generate lokal / di VPS) ──
/db/

# ── Folder kerja sandbox — bukan bagian dari project ──
/upload/
/download/
/tool-results/
/unused-ui-backup/
/.zscripts/
/examples/
/mini-services/
/tests/
/skills/
Caddyfile

# editor / agent leftovers
local-*
.claude
.z-ai-config
prompt
